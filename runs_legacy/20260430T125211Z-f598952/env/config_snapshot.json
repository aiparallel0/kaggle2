  "emit_vocab_size": 259,
  "emit_max_len": 96,
  "emit_beam_width": 4,
  "kd_attn_weight": 0.3,
  "kd_logits_weight": 0.5,
  "fields": ["company", "date", "address", "total"],
  "new_tokens": [
    "<s_sroie>", "</s_sroie>",
