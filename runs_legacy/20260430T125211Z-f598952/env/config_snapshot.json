  "paper_template": "./report/template.tex",
  "paper_output": "./report/paper_filled.tex",
  "yolo_conf": 0.25,
  "trocr_max_new_tokens": 64,
  "max_regions_per_image": 96,
  "address_accept_fraction": 0.5,
  "regex_router": true,
  "text_pool_learned": false,
  "total_confidence_threshold": 0.35,
  "lr_focus": 3e-4,
  "warmup_ratio_focus": 0.1,
  "priors_v3": true,
  "priors_v4": true,
  "focus_enabled": true,
  "focus_total_enabled": true,
  "focus_company_enabled": true,
  "focus_company_confidence_threshold": 0.40,
  "focus_company_span_enabled": true,
  "focus_company_span_max_span": 4,
