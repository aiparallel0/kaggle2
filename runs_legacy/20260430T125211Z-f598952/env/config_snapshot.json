{
  "seed": 42,
  "seeds": [42],
  "n_trials": 1,
  "bootstrap_n_iter": 1000,
  "bootstrap_ci_level": 0.95,
  "base_model": "naver-clova-ix/donut-base",
  "trocr_model": "microsoft/trocr-small-printed",
  "yolo_model": "yolov8n.pt",
  "image_size": [1280, 960],
  "yolo_image_size": 1024,
  "max_length": 256,
  "trocr_max_len": 128,
  "epochs_donut": 35,
  "epochs_yolo": 50,
  "epochs_trocr": 12,
  "batch_size": 4,
  "grad_accum": 4,
  "lr": 5e-5,
  "lr_decoder": 5e-4,
  "warmup_steps": 0,
  "warmup_ratio": 0.05,
  "lr_scheduler_type": "cosine",
