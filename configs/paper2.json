{
  "_comment": "Paper 2 config preset — canonical SROIE Task-3 (347 images), DONUT (paper-recipe) + YOLO+TrOCR+rules+zone_prior pipeline.  All FOCUS-T learned-assigner heads and FOCUS-Σ verifier are OFF: this is the rules-and-spatial-prior arm Paper 2 reports against DONUT.  The rest of the file is identical to configs/default.json except for the override block at the end.  Run with: python main.py --config configs/paper2.json --stage all",
  "seed": 42,
  "seeds": [42, 1, 2, 3, 5],
  "n_trials": 5,
  "bootstrap_n_iter": 1000,
  "bootstrap_ci_level": 0.95,
  "base_model": "naver-clova-ix/donut-base",
  "trocr_model": "microsoft/trocr-small-printed",
  "yolo_model": "yolov8n.pt",
  "image_size": [1280, 960],
  "yolo_image_size": 1024,
  "yolo_crop_pad_px": 6,
  "max_length": 768,
  "trocr_max_len": 128,
  "epochs_donut": 30,
  "epochs_yolo": 50,
  "epochs_trocr": 12,
  "batch_size": 1,
  "grad_accum": 1,
  "lr": 3e-5,
  "lr_decoder": 3e-5,
  "warmup_steps": 300,
  "warmup_ratio": 0.0,
  "lr_scheduler_type": "cosine",
  "gradient_checkpointing": true,
  "num_beams": 1,
  "weight_decay": 0.0,
  "weight_decay_focus": 0.01,
  "dropout_focus": 0.3,
  "label_smoothing": 0.0,
  "precision": "bf16",
  "epochs_focus": 60,
  "focus_patience": 20,
  "focus_min_delta": 0.005,
  "priors_v2": true,
  "patience": 10,
  "max_grad_norm": 1.0,
  "f1_warn_threshold": 0.75,
  "skip_donut": false,
  "focus_hidden_dim": 192,
  "focus_n_layers_level2": 3,
  "emit_hidden": 128,
  "emit_vocab_size": 259,
  "emit_max_len": 96,
  "emit_beam_width": 4,
  "kd_attn_weight": 0.0,
  "kd_logits_weight": 0.0,
  "fields": ["company", "date", "address", "total"],
  "new_tokens": [
    "<s_sroie>", "</s_sroie>",
    "<s_company>", "</s_company>",
    "<s_date>", "</s_date>",
    "<s_address>", "</s_address>",
    "<s_total>", "</s_total>"
  ],
  "sroie_url": "https://github.com/zzzDavid/ICDAR-2019-SROIE.git",
  "data_dir": "./data/sroie_cache",
  "output_dir": "./results",
  "runs_root": "./runs",
  "paper_template": "./report/template_paper2.tex",
  "paper_output": "./report/paper2_filled.tex",
  "yolo_conf": 0.25,
  "trocr_max_new_tokens": 64,
  "max_regions_per_image": 96,
  "address_accept_fraction": 0.5,
  "regex_router": true,
  "text_pool_learned": false,
  "total_confidence_threshold": 0.35,
  "lr_focus": 3e-4,
  "warmup_ratio_focus": 0.1,
  "priors_v3": true,
  "priors_v4": false,
  "focus_enabled": false,
  "focus_total_enabled": false,
  "focus_company_enabled": false,
  "focus_company_confidence_threshold": 0.40,
  "focus_company_span_enabled": false,
  "focus_company_span_max_span": 4,
  "focus_company_span_iou_w": 1.0,
  "focus_company_span_boundary_w": 1.0,
  "focus_company_confidence_floor": 0.20,
  "focus_total_aux_w": 0.0,
  "focus_company_pos_aux_w": 0.0,
  "total_arithmetic_enabled": false,
  "zone_prior_enabled": true,
  "zone_totals_floor": 0.5,
  "zone_header_floor": 0.4,
  "zone_regex_total_floor": 0.2,
  "zone_params_path": "",
  "focus_max_span": 8,
  "focus_iou_weight": 1.0,
  "focus_boundary_weight": 1.0,
  "negative_mass_weight": 0.0,
  "focus_ctkr_k": 4,
  "focus_ctkr_margin": 0.05,
  "focus_ctkr_weight": 0.0,
  "focus_synth_subtotal": 0.0,
  "focus_hardneg_weight": 0.0,
  "assigner_kd_weight": 0.0,
  "assigner_ocr_noise": 0.0,
  "bug_flags": {
    "bug_1": true, "bug_2": true, "bug_3": true, "bug_4": true,
    "bug_5": true, "bug_6": true, "bug_7": true, "bug_8": true,
    "bug_9": true, "bug_10": true, "bug_11": true, "bug_12": true,
    "bug_13": true, "bug_18": false
  },
  "rag_enabled": false,
  "rag_k": 3,
  "gat_enabled": false,
  "foundation_enabled": false,
  "foundation_api": "anthropic",
  "foundation_cache_path": "./runs/foundation_cache.json",

  "canonical_sroie_enabled": true,
  "canonical_sroie_test_path": "",
  "canonical_sroie_test_url": "https://rrc.cvc.uab.es/downloads/SROIE_test_images_task_3.zip",
  "canonical_sroie_gt_url": "https://rrc.cvc.uab.es/downloads/SROIE_test_gt_task_3.zip",
  "canonical_sroie_hf_repo": "Metric-AI/icdar_sroie",
  "canonical_sroie_hf_revision": "main",
  "paper_variant": "paper2",
  "layoutlmv3_enabled": false,
  "layoutlmv3_model": "microsoft/layoutlmv3-base",
  "measure_latency": false,
  "qualitative_sample_ids": [],
  "fig1_receipt_id": "",
  "strict_paper": false
}
