{
  "seed": 42,
  "base_model": "naver-clova-ix/donut-base",
  "trocr_model": "microsoft/trocr-base-printed",
  "yolo_model": "yolov8n.pt",
  "image_size": [1280, 960],
  "yolo_img_size": 512,
  "max_length": 256,
  "trocr_max_len": 128,
  "epochs_donut": 30,
  "epochs_yolo": 50,
  "epochs_trocr": 10,
  "batch_size": 8,
  "grad_accum": 2,
  "lr": 5e-5,
  "lr_decoder": 5e-4,
  "warmup_steps": 0,
  "warmup_ratio": 0.1,
  "lr_scheduler_type": "cosine",
  "gradient_checkpointing": true,
  "num_beams": 4,
  "weight_decay": 0.01,
  "label_smoothing": 0.0,
  "precision": "bf16",
  "epochs_assigner": 20,
  "patience": 10,
  "max_grad_norm": 1.0,
  "expected_f1_warn": 0.75,
  "fields": ["company", "date", "address", "total"],
  "new_tokens": [
    "<s_sroie>", "</s_sroie>",
    "<s_company>", "</s_company>",
    "<s_date>", "</s_date>",
    "<s_address>", "</s_address>",
    "<s_total>", "</s_total>"
  ],
  "sroie_url": "https://github.com/zzzDavid/ICDAR-2019-SROIE.git",
  "data_dir": "./data/sroie_cache",
  "output_dir": "./results",
  "paper_template": "./report/template.tex",
  "paper_output": "./report/paper_filled.tex",
  "yolo_conf": 0.25,
  "trocr_max_new_tokens": 64,
  "max_regions_per_image": 32
}
