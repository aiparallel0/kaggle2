{
  "seed": 42,
  "seeds": [42, 7, 123],
  "n_trials": 3,
  "bootstrap_n_iter": 1000,
  "bootstrap_ci_level": 0.95,
  "base_model": "naver-clova-ix/donut-base",
  "trocr_model": "microsoft/trocr-small-printed",
  "yolo_model": "yolov8n.pt",
  "image_size": [1280, 960],
  "yolo_img_size": 1024,
  "max_length": 256,
  "trocr_max_len": 128,
  "epochs_donut": 35,
  "epochs_yolo": 50,
  "epochs_trocr": 12,
  "batch_size": 4,
  "grad_accum": 4,
  "lr": 5e-5,
  "lr_decoder": 5e-4,
  "warmup_steps": 0,
  "warmup_ratio": 0.05,
  "lr_scheduler_type": "cosine",
  "gradient_checkpointing": true,
  "num_beams": 4,
  "weight_decay": 0.01,
  "weight_decay_assigner": 0.01,
  "dropout_assigner": 0.3,
  "label_smoothing": 0.1,
  "precision": "bf16",
  "epochs_assigner": 60,
  "assigner_patience": 20,
  "assigner_min_delta": 0.005,
  "priors_v2": true,
  "patience": 10,
  "max_grad_norm": 1.0,
  "expected_f1_warn": 0.75,
  "skip_donut": false,
  "assigner_hidden": 192,
  "assigner_n_layers_level2": 3,
  "emit_hidden": 128,
  "emit_vocab_size": 259,
  "emit_max_len": 96,
  "emit_beam_width": 4,
  "kd_attn_weight": 0.3,
  "kd_logits_weight": 0.5,
  "fields": ["company", "date", "address", "total"],
  "new_tokens": [
    "<s_sroie>", "</s_sroie>",
    "<s_company>", "</s_company>",
    "<s_date>", "</s_date>",
    "<s_address>", "</s_address>",
    "<s_total>", "</s_total>"
  ],
  "sroie_url": "https://github.com/zzzDavid/ICDAR-2019-SROIE.git",
  "data_dir": "./data/sroie_cache",
  "output_dir": "./results",
  "runs_root": "./runs",
  "paper_template": "./report/template.tex",
  "paper_output": "./report/paper_filled.tex",
  "yolo_conf": 0.25,
  "trocr_max_new_tokens": 64,
  "max_regions_per_image": 96,
  "address_accept_fraction": 0.5,
  "regex_router": true,
  "text_pool_learned": false,
  "total_confidence_threshold": 0.55,
  "lr_assigner": 3e-4,
  "warmup_ratio_assigner": 0.1,
  "priors_v3": true,
  "assigner_synth_subtotal": 0.3,
  "assigner_hardneg_weight": 0.5,
  "bug_flags": {
    "bug_1": true, "bug_2": true, "bug_3": true, "bug_4": true,
    "bug_5": true, "bug_6": true, "bug_7": true, "bug_8": true,
    "bug_9": true, "bug_10": true, "bug_11": true, "bug_12": true,
    "bug_13": true
  },
  "rag_enabled": false,
  "rag_k": 3,
  "gat_enabled": false,
  "foundation_enabled": false,
  "foundation_api": "anthropic",
  "foundation_cache_path": "./runs/foundation_cache.json",

  "canonical_sroie_enabled": false,
  "canonical_sroie_test_path": "",
  "layoutlmv3_enabled": false,
  "layoutlmv3_model": "microsoft/layoutlmv3-base",
  "measure_latency": false,
  "qualitative_sample_ids": [],
  "fig1_receipt_id": "",
  "strict_paper": false
}
