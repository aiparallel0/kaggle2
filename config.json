{
  "seed": 42,
  "base_model": "naver-clova-ix/donut-base",
  "trocr_model": "microsoft/trocr-small-printed",
  "yolo_model": "yolov8n.pt",
  "image_size": [1280, 960],
  "yolo_img_size": 1024,
  "max_length": 256,
  "trocr_max_len": 128,
  "epochs_donut": 35,
  "epochs_yolo": 50,
  "epochs_trocr": 12,
  "batch_size": 8,
  "grad_accum": 2,
  "lr": 5e-5,
  "lr_decoder": 5e-4,
  "warmup_steps": 0,
  "warmup_ratio": 0.05,
  "lr_scheduler_type": "cosine",
  "gradient_checkpointing": true,
  "num_beams": 4,
  "weight_decay": 0.01,
  "weight_decay_assigner": 5e-4,
  "dropout_assigner": 0.2,
  "label_smoothing": 0.1,
  "precision": "bf16",
  "epochs_assigner": 25,
  "assigner_patience": 7,
  "assigner_min_delta": 0.005,
  "priors_v2": true,
  "patience": 10,
  "max_grad_norm": 1.0,
  "expected_f1_warn": 0.75,
  "skip_donut": false,
  "assigner_hidden": 192,
  "assigner_n_layers_level2": 3,
  "emit_hidden": 128,
  "emit_vocab_size": 259,
  "emit_max_len": 96,
  "emit_beam_width": 4,
  "kd_attn_weight": 0.0,
  "kd_logits_weight": 0.0,
  "fields": ["company", "date", "address", "total"],
  "new_tokens": [
    "<s_sroie>", "</s_sroie>",
    "<s_company>", "</s_company>",
    "<s_date>", "</s_date>",
    "<s_address>", "</s_address>",
    "<s_total>", "</s_total>"
  ],
  "sroie_url": "https://github.com/zzzDavid/ICDAR-2019-SROIE.git",
  "data_dir": "./data/sroie_cache",
  "output_dir": "./results",
  "paper_template": "./report/template.tex",
  "paper_output": "./report/paper_filled.tex",
  "yolo_conf": 0.25,
  "trocr_max_new_tokens": 64,
  "max_regions_per_image": 96
}
